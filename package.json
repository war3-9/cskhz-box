  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "assets:generate": "node scripts/builtin-pack.cjs && node scripts/generate-icon.cjs",
    "assets:pack": "node scripts/builtin-pack.cjs",
    "format": "prettier --write src scripts *.json *.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:portable": "tauri build --no-bundle",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
