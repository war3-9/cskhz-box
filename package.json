    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@zip.js/zip.js": "2.23.0",
    "bmp-js": "^0.1.0",
    "buffer": "6.0.3",
    "dds-parser": "1.0.1",
    "excel-formula-tokenizer": "3.0.0",
    "fast-formula-parser": "1.0.19",
    "fengari": "0.1.5",
    "gifenc": "^1.0.3",
    "gl-matrix": "3.3.0",
    "idb-keyval": "^6.2.2",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.0",
    "saxes": "6.0.0",
    "three": "^0.160.1",
    "use-image": "^1.1.4",
