    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.74",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
